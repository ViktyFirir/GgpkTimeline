<Window x:Class="GgpkTimeline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GgpkTimeline.Controls"
        Title="ГГПК через года"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource NavyBrush}"
        FontFamily="{StaticResource MainFont}"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewMouseLeftButtonDown="Window_PreviewMouseDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseUp">

    <Grid>
        <!-- Фон: PreMain.png (1920x1080 на экране, пикселей больше - для чёткости) -->
        <Grid.Background>
            <ImageBrush ImageSource="Assets/PreMain.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Макет рассчитан на 1920x1080 и масштабируется под любой экран -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="Stage" Width="1920" Height="1080" ClipToBounds="True">

                <!-- СЛОЙ 1 (сзади): год-барабан и финальная надпись. Стоят на месте -->
                <Canvas x:Name="YearLayer"/>

                <!-- СЛОЙ 2: город. Лежит в Canvas, иначе WPF обрезает картинку шире экрана до 1920 px -->
                <Canvas IsHitTestVisible="False" Opacity="0.55">   <!-- прозрачность города: 0 = невидим, 1 = плотный -->
                    <Image x:Name="City" Source="Assets/Silhouette.png" Stretch="Fill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Opacity="0" IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="CityShift" X="0" Y="0"/>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>

                <!-- СЛОЙ 3: карточка (стоит на месте, меняется только текст) -->
                <ctl:InfoCard x:Name="Card" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="120,240,0,0"/>

                <!-- ЗАКРЕПЛЕНО: логотип -->
                <Image x:Name="Logo" Source="Assets/LOGO.png"
                       Width="290" Height="181"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="0" IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="LogoShift" Y="-40"/>
                    </Image.RenderTransform>
                </Image>

                <!-- ЗАКРЕПЛЕНО: футер (голубая линия) -->
                <Grid x:Name="Footer" Height="100" VerticalAlignment="Bottom">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="FooterShift" Y="100"/>
                    </Grid.RenderTransform>

                    <Border Background="{StaticResource BlueBrush}"/>

                    <!-- Оранжевая линия таймлайна: самый верх футера, голубого над ней не видно -->
                    <Rectangle Height="6" VerticalAlignment="Top" Margin="295,0,0,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E66635" Offset="0"/>
                                <GradientStop Color="#E66635" Offset="0.9"/>
                                <GradientStop Color="#00E66635" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Оранжевый блок с названием периода -->
                    <Border Width="295" HorizontalAlignment="Left" Background="{StaticResource OrangeBrush}">
                        <TextBlock x:Name="FooterLabel" Text="1950-ые года"
                                   Foreground="White" FontWeight="Light" FontSize="30"
                                   VerticalAlignment="Center" Margin="47,0,0,0"/>
                    </Border>

                    <!-- Кружки и подписи (создаются в коде) -->
                    <Canvas x:Name="DotsCanvas"/>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Всплывающее уведомление для кнопок-заглушек -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                Background="#F2215CF0" CornerRadius="14" Padding="28,14"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="20" FontWeight="Medium"/>
        </Border>
    </Grid>
</Window>
