<UserControl x:Class="GgpkTimeline.Controls.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource MainFont}">

    <!-- Спокойный градиентный фон вместо плоского синего -->
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#0E1F5C" Offset="0"/>
            <GradientStop Color="#08133A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <UserControl.Resources>
        <!-- Оранжевая кнопка (заглушка), без свечения -->
        <Style x:Key="OrangeButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#E0703F" CornerRadius="22"
                                Padding="30,11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EB7F4F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9602F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка закрытия (круглая, спокойная) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#EBD9BC"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="23" Background="Transparent"
                                BorderBrush="#66EBD9BC" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33EBD9BC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Первый (главный) абзац -->
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Foreground" Value="#EBD9BC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>

        <!-- Обычные абзацы: мягкий светло-голубой, а не чисто белый -->
        <Style x:Key="Paragraph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#C9D3EE"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="31"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- Анимации появления -->
        <Storyboard x:Key="IntroAnimation">
            <!-- Кнопка -->
            <DoubleAnimation Storyboard.TargetName="InfoButton"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.6"/>

            <DoubleAnimation Storyboard.TargetName="CloseButton"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.2" Duration="0:0:0.6"/>

            <!-- Логотип на фоне (To — яркость логотипа, 0..1) -->
            <DoubleAnimation Storyboard.TargetName="LogoBg"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="0.18" Duration="0:0:1.5"/>

            <!-- Заголовок: fade + сдвиг сверху вниз -->
            <DoubleAnimation Storyboard.TargetName="TitleText"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="TitleShift"
                             Storyboard.TargetProperty="Y"
                             From="-40" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Тонкая черта под заголовком растёт из центра -->
            <DoubleAnimation Storyboard.TargetName="TitleLineScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0" To="1" BeginTime="0:0:0.6" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Текст и флаг: fade + сдвиг снизу вверх -->
            <DoubleAnimation Storyboard.TargetName="BodyPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.7" Duration="0:0:1.0"/>
            <DoubleAnimation Storyboard.TargetName="BodyShift"
                             Storyboard.TargetProperty="Y"
                             From="40" To="0" BeginTime="0:0:0.7" Duration="0:0:1.0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Логотип колледжа на заднем плане (растягивается под окно) -->
        <Image x:Name="LogoBg"
               Source="pack://application:,,,/Assets/about_logo.png"
               Stretch="Uniform"
               Margin="30"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Opacity="0"
               IsHitTestVisible="False"/>

        <!-- Весь контент масштабируется под размер окна (адаптив, без прокрутки) -->
        <Viewbox Stretch="Uniform" Margin="20,10,20,20">
            <Grid Width="1100" Height="780">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок с тонкой чертой -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="О нас"
                               FontSize="62" FontFamily="{StaticResource HeavyFont}"
                               Foreground="#EBD9BC"
                               HorizontalAlignment="Center"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" Y="-40"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Border Width="70" Height="3" CornerRadius="2"
                            Background="#E0703F" Margin="0,12,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="TitleLineScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>

                <!-- Текст и флаг (без рамки-карточки) -->
                <StackPanel x:Name="BodyPanel" Grid.Row="1"
                            MaxWidth="900" Margin="0,34,0,0"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="BodyShift" Y="40"/>
                    </StackPanel.RenderTransform>

                    <TextBlock Style="{StaticResource Lead}"
                               Text="Нам 70. Мы храним традиции с 1956 года и создаём будущее. Это приложение — машина времени."/>

                    <TextBlock Style="{StaticResource Paragraph}"
                               Text="За эти годы колледж стал местом, где учились, дружили и находили своё призвание многие поколения студентов. Здесь из года в год передаются знания, мастерство и уважение к своему делу."/>

                    <TextBlock Style="{StaticResource Paragraph}"
                               Text="Мы росли и менялись вместе со временем: появлялись новые специальности, современные лаборатории и мастерские. Но неизменным оставалось главное — стремление давать качественное образование и воспитывать достойных специалистов."/>

                    <TextBlock Style="{StaticResource Paragraph}"
                               Text="Листайте страницы нашей истории, вспоминайте любимых преподавателей и яркие моменты студенческой жизни, делитесь ею вместе с нами."/>

                    <!-- Флаг колледжа: тонкая рамка, лёгкая тень, чуть приглушён -->
                    <Rectangle Width="340" Height="241"
                               RadiusX="14" RadiusY="14"
                               Stroke="#55EBD9BC" StrokeThickness="1"
                               Opacity="0.92"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/about_flag.png"
                                        Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="20"
                                              ShadowDepth="4" Opacity="0.35"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </StackPanel>
            </Grid>
        </Viewbox>

        <!-- Кнопка в левом верхнем углу окна (не масштабируется вместе с текстом) -->
        <Button x:Name="InfoButton"
                Content="О программе"
                Style="{StaticResource OrangeButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="24,20,0,0"
                Opacity="0" Click="InfoButton_Click"/>

        <!-- Закрыть страницу (справа сверху) -->
        <Button x:Name="CloseButton"
                Content="✕"
                Style="{StaticResource CloseButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,24,0"
                Opacity="0" Click="CloseButton_Click"/>
    </Grid>
</UserControl>
