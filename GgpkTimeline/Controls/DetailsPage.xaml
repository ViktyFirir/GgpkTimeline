<UserControl x:Class="GgpkTimeline.Controls.DetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource MainFont}">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#0E1F5C" Offset="0"/>
            <GradientStop Color="#08133A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <!-- Прокрутка на всю страницу. Полоса скрыта (Hidden), но прокрутка колёсиком работает -->
        <ScrollViewer x:Name="DetailsScroller"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Focusable="False">

            <!-- Внутренний Grid: картинка-фон + линия + контент -->
            <Grid>

                <!-- Фон шапки: Assets/DetailFon.png. Подключается в коде (DetailsPage.xaml.cs),
                     поэтому если файла нет - страница всё равно открывается, просто без картинки -->

                <Image x:Name="HeaderBg"
                       Source="pack://application:,,,/Assets/DetailFon.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"/>

                <!-- Оранжевая линия слева - на всю высоту контента -->
                <Rectangle Width="4" Fill="#E66635"
                           HorizontalAlignment="Left" VerticalAlignment="Stretch"
                           Margin="49,0,0,0"/>

                <!-- Контент: одна вертикальная колонка с отступом 100px от левого края -->
                <StackPanel Margin="100,60,100,80" MaxWidth="1400" HorizontalAlignment="Left">

                    <!-- Большой год (из timeline.json: year) -->
                    <TextBlock x:Name="TitleText"
                               FontSize="180" FontFamily="{StaticResource HeavyFont}"
                               FontWeight="ExtraBold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Left"
                               Opacity="0"
                               Margin="0,0,0,30">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" Y="-40"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Основной контент, появление с задержкой -->
                    <StackPanel x:Name="BodyPanel" Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="BodyShift" Y="40"/>
                        </StackPanel.RenderTransform>

                        <!-- Подзаголовок (title) -->
                        <TextBlock x:Name="SubTitleText"
                                   FontSize="38" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <!-- Вступительный текст (text) -->
                        <TextBlock x:Name="IntroText"
                                   FontSize="22" Foreground="#C9D3EE" TextWrapping="Wrap"
                                   LineHeight="32" Margin="0,0,0,50"/>

                        <!-- Две фотографии периода (images[0] и images[1]) в один ряд (создаются в коде) -->
                        <Grid x:Name="PhotosGrid" Margin="0,0,0,50"/>

                        <!-- Второй абзац (details[0]) и остальные абзацы, которые не повторяют подпись к портрету -->
                        <StackPanel x:Name="ExtraPanel" Margin="0,0,0,40"/>

                        <!-- Портрет (images[2]): овал слева, заголовок и описание справа -->
                        <StackPanel x:Name="ImagesPanel"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопка закрытия: поверх всего, в правом верхнем углу окна -->
        <Button x:Name="CloseButton"
                Content="✕"
                Style="{StaticResource CloseButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,24,0"
                Opacity="0" Click="CloseButton_Click"
                Panel.ZIndex="10"/>

        <!-- Просмотр картинки на весь экран: открывается по клику на фото, закрывается по клику, Esc или кнопке -->
        <Grid x:Name="Lightbox"
              Visibility="Collapsed" Opacity="0"
              Background="#F2050C26"
              Focusable="True"
              Panel.ZIndex="20"
              MouseLeftButtonDown="Lightbox_MouseLeftButtonDown"
              KeyDown="Lightbox_KeyDown">
            <Image x:Name="LightboxImage"
                   Stretch="Uniform"
                   Margin="80,70"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LightboxScale" ScaleX="0.95" ScaleY="0.95"/>
                </Image.RenderTransform>
            </Image>
            <Button Content="✕"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,20,24,0"
                    Click="LightboxClose_Click"/>
        </Grid>
    </Grid>
</UserControl>
